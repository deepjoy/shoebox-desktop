{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shoebox",
  "version": "0.2.0",
  "identifier": "us.deepjoy.shoebox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shoebox",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCQkQ1QzdGQjJCQjEzMTEKUldRUkU3dXlmMXk5Mjl0VW9KOUwrcGFjcUZVUnNVUVBIMXhkcDh0VFAzdzU3VCs4eG53ek1WRFQK",
      "endpoints": [
        "https://github.com/deepjoy/shoebox-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
